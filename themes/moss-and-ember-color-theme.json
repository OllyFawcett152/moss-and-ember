    "list.activeSelectionForeground": "#fbf6ea",
    "list.focusBackground": "#8a9a5b66",
    "list.highlightForeground": "#c4622d",
    "list.hoverBackground": "#8a9a5b33",
    "list.inactiveSelectionBackground": "#c9d2ae",
    "minimap.background": "#f7ecd8",
