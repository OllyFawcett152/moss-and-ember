    "editorGutter.background": "#f7ecd8",
    "editorHoverWidget.background": "#f5e8d2",
    "editorHoverWidget.border": "#d9b98f",
    "editorIndentGuide.activeBackground": "#081e2580",
    "editorIndentGuide.activeBackground1": "#d98a4e",
    "editorIndentGuide.background": "#586e7580",
    "editorIndentGuide.background1": "#e2d0b0",
